# HostelOS Environment Variables
# Copy this file to .env.local and fill in all values

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HostelOS"
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hostel-os?retryWrites=true&w=majority

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
AUTH_SECRET=your-super-secret-32-char-minimum-string
AUTH_URL=http://localhost:3000

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="HostelOS <noreply@hostel-os.com>"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Rate Limiting (optional Redis) ──────────────────────────────────────────
# Leave blank to use in-memory rate limiter (not suitable for multi-instance production)
REDIS_URL=
