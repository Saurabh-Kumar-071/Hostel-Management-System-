{
  "appId": "com.hostelos.app",
  "productName": "HostelOS",
  "electronVersion": "45.3.4",
  "copyright": "Copyright © 2026 HostelOS",
  "directories": {
    "output": "../dist-electron"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../.next/standalone",
      "to": "standalone",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
